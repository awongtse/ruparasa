# Salin file ini menjadi ".env" lalu isi sesuai keinginanmu.

# Password untuk login upload (ganti dengan password rahasiamu sendiri)
ADMIN_PASSWORD=gantidenganpasswordmu

# Kunci acak untuk session login (boleh diisi teks acak apa saja, jangan dibagikan)
SESSION_SECRET=ubah-ini-jadi-teks-acak-yang-panjang

# Port server berjalan
PORT=3000
